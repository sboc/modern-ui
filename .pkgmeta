package-as: modern-ui

# The addon lives in the modern-ui/ subfolder; lift it to the package root.
move-folders:
  modern-ui/modern-ui: modern-ui

# Written by the release workflow from the commits since the previous tag.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - curseforge-description.md
  - install.sh
  - logo.png
